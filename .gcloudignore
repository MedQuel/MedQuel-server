.git
.gitignore
.gitmodules
.gcloudignore

# Monorepo siblings: never upload these to Cloud Build
client/

# Backend build artifacts / secrets
node_modules/
dist/
.env
config/serviceAccountKey.json
*.md
npm-debug.log
.vscode/
.github/

# Firebase CLI artifacts, irrelevant to gcloud run deploy.
firebase.json
firestore.rules
firestore.indexes.json
firebase-debug.log
.firebase/

# Infrastructure files
infra/

# Cloud Functions artifacts - not needed inside the Docker build.
functions/

# Scripts
scripts/

# Throwaway dev tools, not part of the deployed backend
get-token-script/
nginx.local.conf
