    "@google-cloud/bigquery": "^9.5.0",
    "@google-cloud/pubsub": "^6.3.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.2",
    "firebase-admin": "^14.0.0",
    "graphql": "^16.14.2",
