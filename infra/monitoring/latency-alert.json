{
  "displayName": "MedQuel API - P99 Latency > 2s",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "Cloud Run P99 request latency exceeds 2000ms",
      "conditionThreshold": {
        "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"medquel-api\" AND metric.type=\"run.googleapis.com/request_latencies\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_PERCENTILE_99",
            "crossSeriesReducer": "REDUCE_MAX",
            "groupByFields": ["resource.label.service_name"]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 2000,
        "duration": "300s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": ["projects/medquel-prod/notificationChannels/1237581298889189850"],
  "alertStrategy": { "autoClose": "1800s" }
}
