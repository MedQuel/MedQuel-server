rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────> Users
    // Read: only your own profile.
    // Write: only your own profile, AND only for fields the client is allowed to self-edit.
    // Everything that affects trust/economy (role, isPremium, XP, EP, streaks, badges) can only be changed by the backend.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if false;
      
      allow update: if request.auth != null && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'uid', 'role', 'isPremium', 'subscriptionId',
          'xpPoints', 'epPoints', 'currentLevel',
          'currentStreak', 'longestStreak', 'lastActiveDate',
          'totalQuestions', 'totalCorrect', 'studyHours',
          'stats', 'badges', 'badgeProgress', 'badgeEarnedAt',
          'notifPrefs', 'quizPrefs', 'createdAt'
        ]);

      allow delete: if false;

      match /subjectPerformance/{subjectId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /activityLog/{date} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }


    // ─────> Quiz sessions
    match /quizSessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }


    // ─────> Leaderboard
    match /leaderboard/{period}/entries/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }


    // ─────> Chat rooms
    match /chatRooms/{roomId} {
      allow read: if request.auth != null;
      allow write: if false; // room metadata is backend/admin managed

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.userId
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }


    // ─────> Contests
    match /contests/{contestId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /leaderboard/{userId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /contests/{contestId}/participants/{userId} {
      allow read, write: if false;
    }
    match /contestFinalizations/{contestId} {
      allow read, write: if false;
    }
    match /contestTemplates/{templateId} {
      allow read, write: if false;
    }

    // Backend event logs
    match /processedQuizEvents/{sessionId} {
      allow read, write: if false;
    }
    match /processedBadgeEvents/{sessionId} {
      allow read, write: if false;
    }
    match /processedActivityEvents/{sessionId} {
      allow read, write: if false;
    }


    // ─────> Study plans
    match /studyPlans/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // generated by backend via Gemini
    }


    // ─────> Subscriptions, plans, badges, notifications
    // All backend-managed. Clients never write these directly.
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /badges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /dailyChallenges/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }


    // ─────> Default deny - Anything not explicitly matched above is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
