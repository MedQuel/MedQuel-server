rules_version = '2';


service cloud.firestore {
  match /databases/{database}/documents {

    // ─────> Users
    // Read: only your own profile.
    // Write: only your own profile, AND only for fields the client is allowed to self-edit.
    // Everything that affects trust/economy (role, isPremium, XP, EP, streaks, badges) can only be changed by the backend.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if false;
      
      allow update: if request.auth != null && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'uid', 'displayNameLower', 'role', 'contentScope', 'focusSubjects',
          'describesYou', 'targetExam', 'studyLevel', 'yearOfStudy', 'specialties',
          'isPremium', 'subscriptionId', 'premiumExpiresAt', 'premiumPlanId',
          'xpPoints', 'epPoints', 'currentLevel', 'currentStreak', 'longestStreak',
          'lastActiveDate', 'totalQuestions', 'totalCorrect', 'studyHours',
          'stats', 'badges', 'badgeProgress', 'badgeEarnedAt',
          'notifPrefs', 'quizPrefs', 'notifTokens', 'createdAt',
        ]);

      allow delete: if false;

      match /subjectPerformance/{subjectId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /activityLog/{date} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }


    // ─────> Friends
    match /users/{userId}/friends/{friendUid} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow write: if false;
    }


    // ─────> Quiz sessions
    match /quizSessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }


    // ─────> Leaderboard
    match /leaderboard/{period}/entries/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }


    // ─────> Contests
    match /contests/{contestId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /leaderboard/{userId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /contests/{contestId}/participants/{userId} {
      allow read, write: if false;
    }
    match /contestFinalizations/{contestId} {
      allow read, write: if false;
    }
    match /contestTemplates/{templateId} {
      allow read, write: if false;
    }

    // Backend event logs
    match /processedQuizEvents/{sessionId} {
      allow read, write: if false;
    }
    match /processedBadgeEvents/{sessionId} {
      allow read, write: if false;
    }
    match /processedActivityEvents/{sessionId} {
      allow read, write: if false;
    }
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow write: if false;
    }


    // ─────> Study plans
    match /studyPlans/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // generated by backend via Gemini
    }


    // ─────> Subscriptions, plans, badges, notifications
    // All backend-managed. Clients never write these directly.
    match /payments/{orderId} {
      allow read, write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /badges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /dailyChallenges/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }


    // ─────> Default deny - Anything not explicitly matched above is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
